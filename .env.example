SOLAR_PUBLIC_ORIGIN=https://solar.mockachino.app
# Standalone: password. Behind Cloudflare Access: cloudflare (no second login).
SOLAR_AUTH_MODE=password
# Required only in cloudflare mode; use your Access application's AUD tag.
SOLAR_CF_TEAM_DOMAIN=
SOLAR_CF_AUD=
# Required only in password mode:
SOLAR_PASSWORD=replace-with-a-long-unique-password
SOLAR_SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional: run as the non-root host account that owns the data bind mount.
SOLAR_UID=10001
SOLAR_GID=10001
